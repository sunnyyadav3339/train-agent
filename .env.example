# ---- Model keys (paste yours; this file's copy .env is never committed) ----
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Models, in priority order: provider/model[:text][@rpm], comma separated ----
# Each call uses the first model that is available. Gemini quotas are per model, so
# listing several Gemini models multiplies the free daily budget. :text = cannot read screenshots.
MODEL_ROUTES=gemini/gemini-3-flash-preview, gemini/gemini-3.5-flash-lite, gemini/gemini-3.1-flash-lite, groq/qwen/qwen3.8-27b, groq/openai/gpt-oss-120b:text

# ---- Loop tuning ----
MAX_STEPS=60
MAX_LONG_EDGE=1280
MAX_ELEMENTS=120
SETTLE_SECONDS=0.6

# ---- Later phases ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_APP_PASSWORD=
CHROME_USER_DATA_DIR=
DRIVE_FOLDER_ID=
